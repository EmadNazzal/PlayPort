NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# `docker compose up -d` starts this database
DATABASE_URL=postgres://playport:playport@localhost:5433/playport

CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Shown in the Sign-In With Solana message; must match the frontend host
APP_DOMAIN=localhost:5173
APP_URL=http://localhost:5173

SOLANA_RPC_URL=https://api.devnet.solana.com
PAYMENT_TTL_MINUTES=15
